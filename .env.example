# Plivo Configuration
PLIVO_AUTH_ID=your_plivo_auth_id
PLIVO_AUTH_TOKEN=your_plivo_auth_token
PLIVO_PHONE_NUMBER=your_plivo_phone_number

# Deepgram Configuration (for Speech-to-Text)
DEEPGRAM_API_KEY=your_deepgram_api_key

# ElevenLabs Configuration (for Text-to-Speech)
ELEVENLABS_API_KEY=your_elevenlabs_api_key

# OpenAI Configuration (for Conversational AI)
OPENAI_API_KEY=your_openai_api_key

# Server Configuration
# For local development: use ngrok URL (e.g., https://abc123.ngrok.io)
# For production: use your Render URL (e.g., https://voice-ai-agent.onrender.com)
SERVER_URL=https://your-deployment-url.onrender.com
